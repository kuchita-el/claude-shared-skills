#!/usr/bin/env bats
# adr プラグインの設定の読み込み（plugins/adr/scripts/adr-config.sh）と、それを使う
# lint-adr.sh・gen-adr-index.sh・commit ゲートのテスト。
#
# 固定するのは次の4つである。
#   - 導入先の設定が語の群を定めると、lint と index の生成器がその語で動く（英語の設定で、
#     valid の ADR 群は exit 0、invalid の ADR 群は該当の違反で exit 1）
#   - 設定の誤り（知らないキー・重複・空の値・語の群の一部だけ・6値の重複・形の崩れた行）は、
#     ADR を検査せずに原因を示して exit 2 で止まる
#   - 設定の置き場は、ADR ディレクトリ（省略時はカレントディレクトリ）から決めた git の
#     トップレベルの `.claude/adr/config` であり、無ければ同梱の既定値を使う。環境変数
#     ADR_CONFIG_ROOT が空でなければ、探索をせずその値をトップレベルとみなす（ゲートとテストが
#     git の外で検査するための内部の経路）
#   - 設定ファイルをシェルとして読み込まない
# 設定ファイルが無い場合に挙動が変わらないことは、既存の lint と index のテスト全件が担う。
#
# 検出の側だけでなく、免除の側も対で置く。語の群を1つも書かない設定は誤りにしない
# （一部だけの検査を「1件でも書けば誤り」へ広げる変異を赤にする）。6値以外のキーとの
# 値の重複は誤りにしない（重複の検査を全キーへ広げる変異を赤にする）。
#
# 【配置について】テストと fixture を配布物外へ置く境界は docs/distribution-boundary.md が定める。
#
# 設定はリポジトリごとに置くため、ケースごとに一時ディレクトリへ git リポジトリを組み立てる。
# よって共有 setup_file の CORPORA は空にし、起動はケース内で `run` により行う。

load 'helpers/common'

SUT="$PLUGIN_ROOT/scripts/lint-adr.sh"
GEN_INDEX="$PLUGIN_ROOT/scripts/gen-adr-index.sh"
CONFIG_LIB="$PLUGIN_ROOT/scripts/adr-config.sh"
CONFIG_DEFAULT="$PLUGIN_ROOT/scripts/adr-config.default"
GATE="$PLUGIN_ROOT/hooks/adr-commit-gate"
CONFIG_FIXTURES="$FIXTURES_DIR/adr-config"
EN_CONFIG="$CONFIG_FIXTURES/en/config"
EN_VALID="$CONFIG_FIXTURES/en/valid"
JA_VALID="$FIXTURES_DIR/lint-adr/valid/01-mixed-validity"
CONFIG_ERROR_MESSAGE="adr プラグインの設定に誤りがあります"
CORPORA=()
# 呼び出し側の環境に残った値で、置き場の解決が変わらないようにする（面⑩だけが明示して渡す）。
unset ADR_CONFIG_ROOT
PRECONDITION_PATHS=("$GEN_INDEX" "$CONFIG_LIB" "$CONFIG_DEFAULT" "$GATE" "$EN_CONFIG" "$EN_VALID" "$JA_VALID")

setup_file() {
    common_setup_file
    command -v git >/dev/null 2>&1 || record_precondition "git が PATH に無い"
    return 0
}

# 英語の設定での invalid の ADR 群。`<ADR 群名>|<期待する違反メッセージの断片>`。
# 断片は、設定の値でメッセージを組み立てていることまで確かめられる形にする。
EN_INVALID_CASES=(
    '01-default-status-value|status の値 "承認済み" が語彙にありません（Proposed / Accepted / Rejected のいずれかが必要）'
    '02-proposed-with-validity|status=Proposed だが validity が空ではありません（値 "Active"。Proposed・Rejected は validity を伴いません）'
    '03-default-xref-heading|の本文 "## Related ADRs" に "Supersedes: ADR-202601010900-01-use-postgres" が見つかりません'
    '04-default-index-title|index 同期違反'
    '05-related-to-superseded|参照先退役違反（"## Related ADRs" の Related 参照先 ADR-202601010900-01-use-postgres は validity=Superseded の退役ADRです）'
)
# 表が削られたまま緑になる経路を塞ぐ下限。ループが実際に照合した回数を数える。
EN_INVALID_CASE_MIN=5

# 設定の誤り。`<fixture 名>|<期待する原因の断片>`。
CONFIG_ERROR_CASES=(
    'unknown-key|知らないキー "validity-abandonned" です'
    'duplicate-key|キー "status-approved" が2回あります'
    'empty-value|キー "index-title" の値が空です'
    'partial-words|語の群の一部だけが書かれています（書かれていないキー: validity-active validity-superseded validity-abandoned xref-heading index-title index-notice）'
    'duplicate-values|status と validity の値に重複があります（status-rejected と validity-superseded がともに "Rejected"）'
    'malformed-line|`キー: 値` の形ではありません（行: index-notice = Generated）'
)
CONFIG_ERROR_CASE_MIN=6

# 一時ディレクトリに git リポジトリを作り、設定（引数2。空なら置かない）と ADR 群（引数3）を
# 置く。ADR 群は docs/adr に置く。作ったリポジトリのパスを REPO へ入れる。
make_repo() {
    local name="$1" config="$2" corpus="$3"
    REPO="$BATS_TEST_TMPDIR/$name"
    mkdir -p "$REPO/docs"
    git -C "$REPO" init -q
    if [ -n "$config" ]; then
        mkdir -p "$REPO/.claude/adr"
        cp "$config" "$REPO/.claude/adr/config"
    fi
    cp -R "$corpus" "$REPO/docs/adr"
}

@test "前提: 被テスト検査器と fixture が存在する" {
    assert_preconditions_met
}

@test "面①: 英語の設定で valid の ADR 群が exit 0 になり、index をその語で生成する" {
    collect_init

    make_repo en-valid "$EN_CONFIG" "$EN_VALID"
    run_sut "$REPO/docs/adr"
    collect_rc 0 "英語の設定で valid の ADR 群は exit 0"
    collect_equals "$output" "" "英語の設定で valid の ADR 群は違反を出さない"

    run bash "$GEN_INDEX" "$REPO/docs/adr" </dev/null
    collect_rc 0 "英語の設定で gen-adr-index.sh は exit 0"
    collect_equals "${lines[0]:-}" "<!-- Generated by gen-adr-index.sh. Do not edit by hand. -->" \
        "index の冒頭の注記が設定の値になる"
    collect_equals "${lines[1]:-}" "# Active ADR Index" "index の題名が設定の値になる"
    collect_contains "$output" "ADR-202601020900-01-use-sqlite" "validity=Active の ADR が index に載る"
    collect_not_contains "$output" "ADR-202601010900-01-use-postgres" "validity=Superseded の ADR は index に載らない"
    collect_equals "$output" "$(cat "$REPO/docs/adr/index.md")" "生成した index がコミット済みの index と一致する"

    collect_finish
}

@test "面②: 英語の設定で invalid の ADR 群が該当の違反で exit 1 になる" {
    collect_init

    local entry name needle matched=0
    for entry in "${EN_INVALID_CASES[@]}"; do
        name="${entry%%|*}"
        needle="${entry#*|}"
        make_repo "en-invalid-$name" "$EN_CONFIG" "$CONFIG_FIXTURES/en/invalid/$name"
        run_sut "$REPO/docs/adr"
        collect_rc 1 "英語の設定で invalid/$name は exit 1"
        collect_contains "$output" "$needle" "英語の設定で invalid/$name は該当の違反を出す"
        matched=$((matched + 1))
    done

    if [ "$matched" -ge "$EN_INVALID_CASE_MIN" ]; then
        collect_ok "invalid の照合件数が下限を満たす（$matched 件 / 下限 $EN_INVALID_CASE_MIN 件）"
    else
        collect_fail "invalid の照合件数が下限を満たす" "照合件数 $matched 件が下限 $EN_INVALID_CASE_MIN 件を下回る"
    fi

    collect_finish
}

# 設定が既定値を置き換えること（足し合わせないこと）と、設定の無いリポジトリが既定値で
# 動くことを、同じ ADR 群の入れ替えで確かめる。
@test "面③: 設定は既定値を置き換え、設定が無ければ既定値を使う" {
    collect_init

    make_repo en-corpus-no-config "" "$EN_VALID"
    run_sut "$REPO/docs/adr"
    collect_rc 1 "設定の無いリポジトリでは、英語の ADR 群が語彙の違反になる"
    collect_contains "$output" 'status の値 "Accepted" が語彙にありません（提案中 / 承認済み / 却下 のいずれかが必要）' \
        "設定の無いリポジトリでは、既定値の語彙で検査する"

    make_repo ja-corpus-en-config "$EN_CONFIG" "$JA_VALID"
    run_sut "$REPO/docs/adr"
    collect_rc 1 "英語の設定のリポジトリでは、既定値の語彙の ADR 群が違反になる"
    collect_contains "$output" 'status の値 "承認済み" が語彙にありません' \
        "英語の設定は既定値の語彙を残さない"

    make_repo ja-corpus-no-config "" "$JA_VALID"
    run_sut "$REPO/docs/adr"
    collect_rc 0 "設定の無いリポジトリでは、既定値の語彙の ADR 群が exit 0"

    collect_finish
}

@test "面④: 設定の誤りは ADR を検査せずに原因を示して exit 2 で止まる" {
    collect_init

    local entry name needle matched=0
    for entry in "${CONFIG_ERROR_CASES[@]}"; do
        name="${entry%%|*}"
        needle="${entry#*|}"
        make_repo "error-$name" "$CONFIG_FIXTURES/errors/$name/config" "$EN_VALID"

        run_sut "$REPO/docs/adr"
        collect_rc 2 "設定の誤り（$name）で lint-adr.sh は exit 2"
        collect_contains "$output" "$CONFIG_ERROR_MESSAGE" "設定の誤り（$name）を設定の誤りとして示す"
        collect_contains "$output" "$needle" "設定の誤り（$name）の原因を示す"
        collect_contains "$output" "$REPO/.claude/adr/config" "設定の誤り（$name）でファイルを名指す"
        collect_not_contains "$output" "違反" "設定の誤り（$name）を ADR の違反として報告しない"

        run bash "$GEN_INDEX" "$REPO/docs/adr" </dev/null
        collect_rc 2 "設定の誤り（$name）で gen-adr-index.sh は exit 2"
        collect_contains "$output" "$needle" "設定の誤り（$name）の原因を gen-adr-index.sh も示す"
        collect_not_contains "$output" "<!--" "設定の誤り（$name）で gen-adr-index.sh は index を出さない"
        matched=$((matched + 1))
    done

    if [ "$matched" -ge "$CONFIG_ERROR_CASE_MIN" ]; then
        collect_ok "設定の誤りの照合件数が下限を満たす（$matched 件 / 下限 $CONFIG_ERROR_CASE_MIN 件）"
    else
        collect_fail "設定の誤りの照合件数が下限を満たす" "照合件数 $matched 件が下限 $CONFIG_ERROR_CASE_MIN 件を下回る"
    fi

    collect_finish
}

@test "面⑤: 誤りの検査は定めた範囲に限る（語の群を書かない設定・6値以外との重複）" {
    collect_init

    make_repo exempt-no-word-keys "$CONFIG_FIXTURES/exempt/no-word-keys/config" "$JA_VALID"
    run_sut "$REPO/docs/adr"
    collect_rc 0 "語の群を1つも書かない設定は誤りにせず、既定値で検査する"

    make_repo exempt-state-value "$CONFIG_FIXTURES/exempt/state-value-in-other-key/config" "$EN_VALID"
    run bash "$GEN_INDEX" "$REPO/docs/adr" </dev/null
    collect_rc 0 "status の値と同じ値を index の題名に使う設定は誤りにしない"
    collect_equals "${lines[1]:-}" "# Accepted" "index の題名に status と同じ値を使える"

    collect_finish
}

# 解決の起点は、引数の ADR ディレクトリ（省略時はカレントディレクトリ）である。
@test "面⑥: 設定の置き場を ADR ディレクトリから決める" {
    collect_init

    make_repo origin-arg "$EN_CONFIG" "$EN_VALID"
    local repo="$REPO"

    # 別のリポジトリ（本リポジトリ）の中から、引数で ADR ディレクトリを渡す
    run bash -c 'cd "$1" && bash "$2" "$3"' _ "$REPO_ROOT" "$SUT" "$repo/docs/adr" </dev/null
    collect_rc 0 "カレントディレクトリと別のリポジトリの ADR ディレクトリでは、そのリポジトリの設定を使う"

    # 引数を省くと、カレントディレクトリから決める
    run bash -c 'cd "$1" && bash "$2"' _ "$repo" "$SUT" </dev/null
    collect_rc 0 "引数を省くと、カレントディレクトリのリポジトリの設定を使う"

    # ADR ディレクトリの下の階層から起動しても、git のトップレベルの設定を使う
    run bash -c 'cd "$1/docs" && bash "$2" adr' _ "$repo" "$SUT" </dev/null
    collect_rc 0 "サブディレクトリから相対パスで渡しても、git のトップレベルの設定を使う"

    # 読み込みだけを行ってレイヤを単独で起動する場合も、対象ディレクトリの設定で検査する
    # （設定の解決を走査対象の収集が持つため。起動部へ移すと、この経路が既定値で検査する）
    run_sut_layer check_layer1_frontmatter_schema "$repo/docs/adr"
    collect_rc 0 "読み込みだけの経路でレイヤ1 を単独で起動できる"
    collect_contains "$output" "[violations=0]" "読み込みだけの経路でも、対象ディレクトリの設定の語彙で検査する"

    # git のトップレベルを決められない場所では、既定値だけを使う
    local plain="$BATS_TEST_TMPDIR/not-a-repo"
    mkdir -p "$plain/.claude/adr"
    cp "$EN_CONFIG" "$plain/.claude/adr/config"
    cp -R "$JA_VALID" "$plain/adr"
    if git -C "$plain" rev-parse --show-toplevel >/dev/null 2>&1; then
        collect_skipped "git の外では既定値だけを使う" "一時ディレクトリが git の作業ツリーの中にある"
    else
        run_sut "$plain/adr"
        collect_rc 0 "git の外では、カレントディレクトリに設定があっても既定値だけを使う"
    fi

    collect_finish
}

# 設定と ADR 群はステージしてからゲートを起動する。ゲートが作業ツリーとステージした内容の
# どちらを検査する形であっても、検査の経路を通すためである（何もステージしていないと、
# ステージした内容を検査するゲートは何もせずに通り、この面が空振りする）。
@test "面⑦: commit ゲートは commit を実行するリポジトリの設定で検査する" {
    collect_init

    local input
    make_repo gate-en "$EN_CONFIG" "$EN_VALID"
    git -C "$REPO" add -A
    input="$(printf '{"tool_input":{"command":"git commit -m x"},"cwd":"%s"}' "$REPO")"
    run bash -c 'cd "$1" && printf "%s" "$2" | bash "$3"' _ "$REPO" "$input" "$GATE"
    collect_rc 0 "英語の設定のリポジトリで、英語の ADR 群は commit を通す"

    make_repo gate-error "$CONFIG_FIXTURES/errors/partial-words/config" "$EN_VALID"
    git -C "$REPO" add -A
    input="$(printf '{"tool_input":{"command":"git commit -m x"},"cwd":"%s"}' "$REPO")"
    run bash -c 'cd "$1" && printf "%s" "$2" | bash "$3"' _ "$REPO" "$input" "$GATE"
    collect_rc 2 "設定に誤りがあるリポジトリでは commit を止める"
    collect_contains "$output" "語の群の一部だけが書かれています" "commit を止めた原因として設定の誤りを示す"

    collect_finish
}

@test "面⑧: 設定ファイルをシェルとして読み込まない" {
    collect_init

    make_repo shell-literal "$CONFIG_FIXTURES/shell-literal/config" "$EN_VALID"
    local marker="$BATS_TEST_TMPDIR/executed"
    run env ADR_CONFIG_MARKER="$marker" bash "$GEN_INDEX" "$REPO/docs/adr" </dev/null
    collect_rc 0 "コマンドの形の値を持つ設定でも gen-adr-index.sh は exit 0"
    if [ -e "$marker" ]; then
        collect_fail "設定の値に書いたコマンドを実行しない" "印のファイルが作られた: $marker"
    else
        collect_ok "設定の値に書いたコマンドを実行しない"
    fi
    collect_equals "${lines[1]:-}" '# $(touch "$ADR_CONFIG_MARKER") `touch "$ADR_CONFIG_MARKER"`' \
        "設定の値を展開せず文字列のまま使う"

    # 読み込み部に、ファイルをコードとして読む構文が無いこと（コメント行を除く）
    local found
    found="$(grep -nE '(^|[;&|[:space:]])(eval|source|\.)[[:space:]]' "$CONFIG_LIB" | grep -vE '^[0-9]+:[[:space:]]*#' || true)"
    collect_equals "$found" "" "adr-config.sh は eval・source・. を使わない"

    collect_finish
}

# 改行コードが CRLF の設定・行末の空白・字下げしたコメント・空白だけの行を、英語の設定から
# その場で組み立てる（CR と行末の空白を追跡下のファイルへ置かないため）。値に CR や空白が
# 残ると、英語の ADR が全件語彙の違反になり、利用者は原因が設定にあると気づけない。
@test "面⑨: CRLF・行末の空白・字下げしたコメントを持つ設定を読める" {
    collect_init

    make_repo crlf-whitespace "" "$EN_VALID"
    mkdir -p "$REPO/.claude/adr"
    {
        printf '   # 字下げしたコメント: コロンを含む\n'
        printf '   \n'
        printf '\t\n'
        sed -e '/^[a-z]/s/$/  \t /' "$EN_CONFIG"
    } | sed -e 's/$/\r/' >"$REPO/.claude/adr/config"

    run_sut "$REPO/docs/adr"
    collect_rc 0 "CRLF・行末の空白・字下げしたコメントを持つ英語の設定で、valid の ADR 群は exit 0"
    collect_equals "$output" "" "CRLF・行末の空白を持つ設定でも違反を出さない"

    run bash "$GEN_INDEX" "$REPO/docs/adr" </dev/null
    collect_rc 0 "CRLF・行末の空白を持つ設定で gen-adr-index.sh は exit 0"
    collect_equals "${lines[1]:-}" "# Active ADR Index" "値に CR と行末の空白を残さない"

    collect_finish
}

# ADR_CONFIG_ROOT は、git の外へ取り出したツリーを検査するための内部の経路である。
@test "面⑩: ADR_CONFIG_ROOT が設定を探すトップレベルを明示する" {
    collect_init

    # git の外の ADR 群を、別の場所のトップレベルの設定で検査する
    local root="$BATS_TEST_TMPDIR/root-en" plain="$BATS_TEST_TMPDIR/plain-en"
    mkdir -p "$root/.claude/adr" "$plain"
    cp "$EN_CONFIG" "$root/.claude/adr/config"
    cp -R "$EN_VALID" "$plain/adr"
    run env ADR_CONFIG_ROOT="$root" bash "$SUT" "$plain/adr" </dev/null
    collect_rc 0 "ADR_CONFIG_ROOT の設定で、git の外の英語の ADR 群を検査できる"
    run env ADR_CONFIG_ROOT="$root" bash "$GEN_INDEX" "$plain/adr" </dev/null
    collect_equals "${lines[1]:-}" "# Active ADR Index" "gen-adr-index.sh も ADR_CONFIG_ROOT の設定を使う"

    # git による探索より優先する。英語の設定を持つリポジトリでも、設定の無いトップレベルを
    # 明示すれば既定値で検査する
    make_repo root-overrides-git "$EN_CONFIG" "$EN_VALID"
    local empty_root="$BATS_TEST_TMPDIR/root-empty"
    mkdir -p "$empty_root"
    run env ADR_CONFIG_ROOT="$empty_root" bash "$SUT" "$REPO/docs/adr" </dev/null
    collect_rc 1 "設定の無いトップレベルを明示すると、既定値で検査する（git による探索をしない）"
    collect_contains "$output" '（提案中 / 承認済み / 却下 のいずれかが必要）' "明示したトップレベルに設定が無ければ既定値の語彙を使う"

    # 空の値は未設定と同じに扱う（git による探索へ戻る）
    run env ADR_CONFIG_ROOT= bash "$SUT" "$REPO/docs/adr" </dev/null
    collect_rc 0 "ADR_CONFIG_ROOT が空なら、git のトップレベルの設定を使う"

    # 指し先が無ければ、既定値へ落とさず原因を示して止める
    run env ADR_CONFIG_ROOT="$BATS_TEST_TMPDIR/__missing__" bash "$SUT" "$REPO/docs/adr" </dev/null
    collect_rc 2 "存在しないディレクトリを指す ADR_CONFIG_ROOT は exit 2"
    collect_contains "$output" "設定を探すトップレベルとして指定されたディレクトリがありません" "存在しない指し先を原因として示す"
    collect_not_contains "$output" "違反" "存在しない指し先を ADR の違反として報告しない"

    # 明示したトップレベルの設定にも、誤りの検査が掛かる
    local bad_root="$BATS_TEST_TMPDIR/root-bad"
    mkdir -p "$bad_root/.claude/adr"
    cp "$CONFIG_FIXTURES/errors/partial-words/config" "$bad_root/.claude/adr/config"
    run env ADR_CONFIG_ROOT="$bad_root" bash "$SUT" "$plain/adr" </dev/null
    collect_rc 2 "ADR_CONFIG_ROOT の設定の誤りも exit 2"
    collect_contains "$output" "語の群の一部だけが書かれています" "ADR_CONFIG_ROOT の設定の誤りの原因を示す"

    collect_finish
}

# 同梱の既定値が、設定ファイルの無いリポジトリでいまの値と一致することは既存のテスト全件が
# 担う。ここでは既定値のファイル自体が語の群を揃えて持ち、読み込み部がそれを受け付けることを
# 確かめる（既定値のファイルの破損を、既存テストの大量の失敗ではなく1件の失敗として示す）。
@test "面⑪: 同梱の既定値が語の群を揃えて持つ" {
    collect_init

    run bash -c 'source "$1"; adr_config_load "" && printf "%s|%s|%s\n" "$ADR_STATUS_APPROVED" "$ADR_XREF_HEADING" "$ADR_INDEX_TITLE"' \
        _ "$CONFIG_LIB" </dev/null
    collect_rc 0 "同梱の既定値を誤りなく読める"
    collect_equals "$output" "承認済み|関連ADR|有効 ADR インデックス" "同梱の既定値の語が読める"

    collect_finish
}
