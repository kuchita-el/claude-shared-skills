#!/usr/bin/env bats
load 'helpers/common'
root="$REPO_ROOT"
# 配布物ルートは1本の定数に集約する。同じリテラルを @test ごとに繰り返すと、
# パス参照台帳の行番号固定面がその数だけ増え、上へ1行挿入するたびに commit が止まる。
DW_ROOT="$root/plugins/dev-workflow"
PLAN_REFS="$DW_ROOT/skills/plan-issue/references"
PLAN_SKILL="$DW_ROOT/skills/plan-issue/SKILL.md"
PLAN_AGENT="$DW_ROOT/agents/plan.md"
PLAN_REVIEWER="$DW_ROOT/agents/plan-reviewer.md"
REVIEW_GUIDE="$PLAN_REFS/review-guide-default.md"

# ---------------------------------------------------------------------------
# Issue #814: プラン規範へ新設した規定の退行検出
#
# 【本ファイルを contract 系と分けて置く理由】
# `dev-workflow-skill-contract.bats` は「文言ではなく構造として観測できる不変条件だけ」を
# 測ると宣言し、散文の逐語照合を意図して排除している（#813 / PR #816）。本ファイルが測る
# のは、その決定が対象とした「文言の推敲で赤くなる照合」ではなく、**新設した規定そのもの
# が言い換えや削除で静かに消えること**の検出である。目的が異なるため同居させず、規範条文
# の退行検出として独立させる。両者を混ぜると、構造検査の側が散文の推敲で赤くなる状態へ
# 戻り、#816 の決定が実質的に取り消される。
#
# 【照合の粒度】
# 結線を見る照合は行ではなく**節**を単位に取る（`plan_norm_slice`）。同一行に全期待語を
# 要求すると、意味を変えない推敲——長い1行を箇条書きへ割る、語順を入れ替える——だけで
# 赤くなり、上記の分離理由が本ファイルの内側で崩れる。節を単位に取れば、規定が節から
# 消えたときにだけ赤くなる。
#
# 新設規定ごとの検査要否と判定理由:
#
#  R1  レビュー経緯の行き先
#      要。条文が言い換え・削除で静かに消える型であり needle で固定できる。接頭辞の位置ごと
#      固定する——語幹後置形へ戻すと implementation が既存プランを特定する Glob
#      （`issue-{番号}-*.md`）に一致し、経緯付録がプラン本体として読まれる経路が生じるため。
#  R2  テンプレート未定義節を追加しない規定
#      不要。本 Issue の新設ではなく既存規定であり、その実効化は R3 の観点12 が担う。
#      同じ対象へ二重に検査を置かない。
#  R3  レビュー観点12
#      要。観点の実在に加え、射程の文言と正規化手順を照合する。射程をレベル列挙の形へ戻す
#      改変は観点の表行・詳細節を残したまま無検査の書き込み先を復活させるため、存在だけを
#      見る照合では捕らえられない。また列挙形にも `###` という語は残るので、レベル記号の
#      出現を見る needle も無効である。実在の照合は表行と詳細節見出しを別々の needle で
#      行う——観点名は両方に現れるため、1本の needle では片方の欠落がもう片方に吸収される。
#      あわせて観点数の宣言（3箇所）と観点表のデータ行数の一致も照合する。宣言は全文 grep
#      ではなく宣言文ごとの位置で固定する——全文から拾うと、宣言ではない語形（「この2観点
#      は…」）が1つ増えるだけで赤くなる。
#  R4  軸の区別の改訂
#      要。宣言した軸数と表のデータ行数の一致を照合する（今回是正した欠陥そのものの再発検出）。
#      検査は走査対象ファイルが同一の authoring-reference-relocation.bats 側へ置く。
#  R5  成果物の書き出し先と手段の併記   要。条文の実在を照合する。
#  R6  読み方区分                     要。値域（規範）と判定条件（生成手順）が別ファイルにあるため両方を照合する。
#  R7  完了条件の検証粒度             要。条文の実在を照合する。
#  R8  レビュアーへ出力テンプレートを渡す結線
#      要。渡し忘れると R3 の観点12 が判定不能のまま常に緑になる。起動側と受け手側の両方を
#      走査し、宣言（5点）と実体（列挙）の食い違いを検出する。項目数だけを数えると、
#      出力テンプレートの項目を別資産へ差し替える改変が点数を保ったまま素通りするため、
#      列挙のどれかが出力テンプレートのファイル名を名指すことまで照合する。
#  R9  経緯付録を書く主体と契機の結線
#      要。R1 の行き先が残っていても結線が消えれば付録は生まれず、分離の形が運用上は
#      「プランへ書かずメイン報告に留める」へ縮退する。行き先の存在検査では穴が残る。
#      契機は3経路ある——修正周回ごとの追記（7c の FAIL 分岐）、2周してもブロッカーが
#      残った場合の追記（ループ終了条件）、裁定後の論拠の移送（ステップ8）。いずれを欠いても、
#      付録が保持すると宣言した3種の記録種別のうち1つが運用上一度も生成されない。
#      あわせて受け手側（plan エージェントの編集モード）の入力契約も照合する——起動側だけを
#      走査すると、渡す資産が増えても受け手の契約が旧点数のまま取り残される食い違いを
#      検出できない（R8 が起動側と受け手側の双方を見るのと同じ理由）。
#  R10 出力テンプレートの読み取り点の単一性
#      要。ステップ6 を元の全文再読の形へ戻しても渡す資産の点数と列挙は無傷のため R8 は
#      緑で通り、同一ファイルの二重読みの復活が無検査になる。規定の負荷を担うのは
#      「同ファイルを再度 Read しない」という否定の指示そのものであり、そこを needle に取る。
#  R11 読み方区分を書く位置のレイアウト規定
#      要。テンプレート側の1文であり、消えるとタスク構造の箇条書きが増える形へ戻りうる。
#      値域そのものは R6 が押さえるため、ここで見るのは書く位置の規定の実在に限る。
#  R12 観点12 の誤検出を防ぐ2つの緩和（正規化の拡張・設計内容の自由枠）
#      要。緩和は「検出を弱める」方向の変更であり、消しても観点12 は動き続けるため、
#      存在検査を置かないと静かに元の過検出へ戻る。自由枠については、レビュー経緯を
#      免除しない旨の但し書きまで照合する——但し書きだけが落ちると、自由枠が
#      観点12 の狙いそのものに対する抜け穴になる。
#
# 上記のうち R4 は authoring-reference-relocation.bats、それ以外は本ファイルが持つ。
# ---------------------------------------------------------------------------

# 開始パターンに一致した行から、以降で終了パターンに一致する行の直前までを切り出す。
plan_norm_slice() {
  awk -v s="$2" -v e="$3" '
    !f && $0 ~ s { f = 1; print; next }
    f && $0 ~ e { exit }
    f { print }
  ' "$1"
}

# 切り出した節が期待語をすべて含むかを判定する。
plan_norm_block_has() {
  local block="$1"
  shift
  local word
  for word in "$@"; do
    case "$block" in
      *"$word"*) ;;
      *) return 1 ;;
    esac
  done
  return 0
}

@test "R1/R3/R5/R6/R7/R11/R12: プラン規範の新設条文が残っている" {
  local -a pairs=(
    'plan-output-format.md::語幹の前に `review-log-` を付した形'
    'plan-output-format.md::review-log-issue-{番号}.md'
    'plan-output-format.md::裁定に至った論拠は経緯付録へ移して'
    'plan-output-format.md::ここに定義されていないセクションは追加しない'
    'plan-prompt.md::プラン本体の節として起こさない'
    'plan-contract.md::読み方区分の付与'
    'plan-contract.md::`全文読み` / `局所読み`'
    'plan-contract.md::置き換えるものではなく併記する'
    'plan-prompt.md::読み方区分の判定'
    'plan-prompt.md::概ね5箇所以上'
    'plan-prompt.md::ファイル全体の構造に依存する編集を含むなら'
    'plan-prompt.md::局所読みの総量が全文を超えるなら'
    'plan-contract.md::完了条件の検証粒度'
    'plan-contract.md::タスクごとの完了条件へ重ねて課さない'
    'plan-contract.md::成果物の書き出し先と手段の併記'
    'plan-contract.md::宛先だけを書いて手段を書かない記載は本必須記載を満たさない'
    'plan-prompt.md::成果物の書き出し先の選び方'
    'plan-prompt.md::作業ディレクトリ配下を既定の宛先とする'
    'plan-prompt.md::手段を確認できない場合は、宛先を作業ディレクトリ配下へ倒す'
    'plan-output-format.md::読み方区分は該当するタスクの「内容」欄へ自然文として書き、箇条書き項目を増やさない'
    'review-guide-default.md::| 12 | 出力テンプレート定義外の節の不在 |'
    'plan-output-format.md::### {設計項目}（該当する場合・任意個）'
    'plan-output-format.md::レビュー経緯・裁定の記録はここへ書かない'
  )
  local -a absent=()
  local checked=0 pair file needle
  # 照合回数は配列の宣言ではなくループ内で数える。宣言の要素数を下限に用いると、
  # ループごと削除されても下限が満たされたまま緑になる。
  for pair in "${pairs[@]}"; do
    file="${pair%%::*}"
    needle="${pair#*::}"
    checked=$((checked + 1))
    grep -qF -e "$needle" "$PLAN_REFS/$file" || absent+=("$file: $needle")
  done
  if [ "${#absent[@]}" -ne 0 ]; then
    printf '条文が見つからない:\n'
    printf '  %s\n' "${absent[@]}"
    return 1
  fi
  [ "$checked" -ge 23 ] || {
    echo "照合件数が下限を下回った: checked=$checked (>=23)"
    return 1
  }
}

@test "R3/R12: 観点12 の射程がレベル列挙で閉じられておらず正規化手順と緩和が残っている" {
  local -a needles=(
    'テンプレートが定義する見出し集合に含まれない `##` 以下のすべての見出し'
    '対象の見出しレベルを列挙して射程を閉じない'
    '見出し末尾の丸括弧注記（`（…）`）を除去してから比較する'
    '除去はテンプレート側とプラン側の双方へ同じく施す'
    '除去対象を `（該当する場合）` へ限定しない'
    'より前の固定部分で比較する'
    '固定部分に連番が含まれる場合はその連番も可変部として扱う'
    '`### Task ` で始まる見出しを一律にタスク見出しとして許容する'
    '同じ固定部を持つ見出しが任意個現れてよい'
    '1件でもあればブロッカー（改善提案に留めない）'
    'レビュー経緯の記録がプラン本体の節として置かれている場合はブロッカー'
    '自由枠は免除しない'
  )
  local -a absent=()
  local checked=0 needle

  # 詳細節の見出しは行頭アンカー付きで照合する。`grep -F` の部分一致だと `#### 12. …` へ
  # レベルを1段下げる改変にも一致してしまい、階層降格が検出できない。
  grep -qE '^### 12\. 出力テンプレート定義外の節の不在' "$REVIEW_GUIDE" || absent+=('^### 12. 出力テンプレート定義外の節の不在（行頭）')
  checked=$((checked + 1))

  for needle in "${needles[@]}"; do
    checked=$((checked + 1))
    grep -qF -e "$needle" "$REVIEW_GUIDE" || absent+=("$needle")
  done
  if [ "${#absent[@]}" -ne 0 ]; then
    printf '観点12 の条文が見つからない:\n'
    printf '  %s\n' "${absent[@]}"
    return 1
  fi
  [ "$checked" -ge 13 ] || {
    echo "照合件数が下限を下回った: checked=$checked (>=13)"
    return 1
  }
}

@test "R3: 観点数の宣言3箇所と観点表のデータ行数が一致する" {
  # 観点を足しながら宣言を旧数のまま残す型の食い違いを検出する。行数は実行時に数える。
  local rows
  rows="$(awk '/^\| # \| 観点 \| チェック項目 \|/{f=1;next} f && /^\|---/{next} f && /^\| /{c++;next} f{exit} END{print c+0}' "$REVIEW_GUIDE")"
  [ "$rows" -gt 0 ] || {
    echo "観点表のデータ行が0件（走査面が失われている）"
    return 1
  }

  # 宣言は宣言文ごとの位置で固定する。全文から `N観点` を拾う形にすると、宣言でない語形が
  # 1つ増えるだけで赤くなり、条文の推敲が検査を壊す。
  local -a exprs=(
    's/.*[^0-9]\([0-9][0-9]*\)の観点でプランを評価する.*/\1/p'
    's/.*上記\([0-9][0-9]*\)観点のうち.*/\1/p'
    's/.*上記\([0-9][0-9]*\)観点で確認する.*/\1/p'
  )
  local expr found declared=0
  for expr in "${exprs[@]}"; do
    found="$(sed -n "$expr" "$REVIEW_GUIDE" | head -1)"
    [[ "$found" =~ ^[0-9]+$ ]] || {
      echo "観点数の宣言が読み取れない: $expr"
      return 1
    }
    declared=$((declared + 1))
    [ "$found" -eq "$rows" ] || {
      echo "観点数の宣言と観点表の行数が食い違う: 宣言=$found 表=$rows ($expr)"
      return 1
    }
  done
  [ "$declared" -eq 3 ] || {
    echo "宣言の照合件数が3に満たない: declared=$declared"
    return 1
  }
}

@test "R8: レビュアーへ出力テンプレートを渡す結線が起動側と受け手側で一致している" {
  local step2 step7a contract
  step2="$(plan_norm_slice "$PLAN_SKILL" '^### 2\. ' '^### 3\. ')"
  step7a="$(plan_norm_slice "$PLAN_SKILL" '^\*\*7a\.' '^\*\*7b\.')"
  contract="$(plan_norm_slice "$PLAN_REVIEWER" '^## 入力' '^## ')"

  plan_norm_block_has "$step2" '5点' || {
    echo "ステップ2 が 5点 を宣言していない"
    return 1
  }
  plan_norm_block_has "$step7a" '5点' '出力テンプレート' || {
    echo "ステップ7a の資産列挙が 5点／出力テンプレート を持たない"
    return 1
  }
  plan_norm_block_has "$contract" '5点' '出力テンプレート' || {
    echo "plan-reviewer の入力契約が 5点／出力テンプレート を持たない"
    return 1
  }

  # 列挙の実体を見る。項目数だけを数えると、出力テンプレートの項目を別資産へ差し替える
  # 改変が点数 5 を保ったまま素通りする。項目のいずれかが出力テンプレートのファイルを
  # 名指していることまで照合する。
  local items
  items="$(printf '%s\n' "$step2" | grep -cE '^[0-9]+\. ' || true)"
  [ "$items" -eq 5 ] || {
    echo "ステップ2 の読み込み項目が5件でない: items=$items"
    return 1
  }
  printf '%s\n' "$step2" | grep -E '^[0-9]+\. ' | grep -qF 'plan-output-format.md' || {
    echo "ステップ2 の読み込み項目が出力テンプレート（plan-output-format.md）を名指していない"
    return 1
  }
}

@test "R9: 経緯付録を書く主体と3つの契機が起動側と受け手側へ結線されている" {
  local step7c loop_end step8 edit_mode
  step7c="$(plan_norm_slice "$PLAN_SKILL" '^\*\*7c\.' '^\*\*ループ終了条件')"
  loop_end="$(plan_norm_slice "$PLAN_SKILL" '^\*\*ループ終了条件' '^### 8\. ')"
  step8="$(plan_norm_slice "$PLAN_SKILL" '^### 8\. ' '^## ')"
  edit_mode="$(plan_norm_slice "$PLAN_AGENT" '^### 編集モード' '^## ')"

  # 契機1: 修正周回ごとの追記。渡す資産（付録のパス）と追記の指示の両方を見る。
  plan_norm_block_has "$step7c" '経緯付録のパス' '経緯付録へ追記' '修正周回ごと' || {
    echo "ステップ7c が付録のパスの受け渡しと修正周回ごとの追記を持たない"
    return 1
  }
  # 契機2: 2周してもブロッカーが残った場合の追記。これを欠くと、付録が保持すると
  # 宣言した「未解消の指摘」を書く主体がループ終了経路に不在のままになる。
  plan_norm_block_has "$loop_end" '経緯付録へ追記' || {
    echo "ループ終了条件が未解消ブロッカーの経緯付録への追記を指示していない"
    return 1
  }
  # 契機3: 裁定後の論拠の移送。これを欠くと「裁定に至った論拠」が一度も生成されない。
  plan_norm_block_has "$step8" '裁定に至った論拠は経緯付録へ移させる' '経緯付録のパス' || {
    echo "ステップ8 が裁定後の論拠の移送を結線していない"
    return 1
  }
  # 受け手側の入力契約。起動側だけを見ると、渡す資産が増えても受け手が旧契約のまま
  # 取り残される食い違い（PR #818 レビュー B2 で現に起きた型）を検出できない。
  plan_norm_block_has "$edit_mode" '経緯付録のパス' '経緯付録へ追記' || {
    echo "plan エージェントの編集モードが経緯付録の入力契約と追記を持たない"
    return 1
  }
}

@test "R10: 出力テンプレートの読み取り点がステップ2 の1点に保たれている" {
  local step6
  step6="$(plan_norm_slice "$PLAN_SKILL" '^### 6\. ' '^### 7\. ')"
  plan_norm_block_has "$step6" '{OUTPUT_FORMAT}' 'ステップ2' '同ファイルを再度 Read しない' || {
    echo "ステップ6 がステップ2 の読み込み結果を用い再読を禁じる形になっていない"
    return 1
  }
}
