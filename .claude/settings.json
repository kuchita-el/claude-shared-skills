{
  "permissions": {
    "allow": [
      "Bash(bash scripts/run-tests.sh*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/hooks/pre-commit-gate.sh\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-shared-skills": {
      "source": {
        "source": "github",
        "repo": "kuchita-el/claude-shared-skills"
      }
    }
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "adr@claude-shared-skills": true
  }
}
